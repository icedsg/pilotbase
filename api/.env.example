# Copy this file to .env and fill in real values before running Pilotbase.
# .env is gitignored — never commit real secrets.

# ── Pilotbase internal database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql+psycopg2://pilotbase:pilotbase_secret@localhost:5432/pilotbase

# ── Security ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# Fernet key used to encrypt every stored connection password.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set this BEFORE creating any connections, and never change it afterward —
# see the README for why.
ENCRYPTION_KEY=change-me-generate-with-fernet-generate_key=

# ── Ollama / AI agent ──────────────────────────────────────────────────────
# OpenAI-compatible endpoint. Use http://localhost:11434/v1 for a local Ollama
# install, or leave the hosted default and set a real OLLAMA_API_KEY.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=your-ollama-apikey-goes-here
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_FLASH_MODEL=gemma4:cloud

# ── External database connections ─────────────────────────────────────────
# Seconds to wait when connecting to a user-added database (any engine) before
# giving up. Lower it to fail faster against unreachable hosts; raise it for
# engines with a naturally slow handshake (e.g. cloud vector DBs doing auth).
DB_CONNECT_TIMEOUT_SECONDS=10

# ── Application ────────────────────────────────────────────────────────────
ENVIRONMENT=development
STATIC_DIR=./static
BACKUPS_DIR=./backups

# "anon" for single-user/anonymous mode, or a dotted path to a custom
# AuthBackend subclass (see app/auth/anon_auth.py for the interface).
AUTH_BACKEND=anon

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
